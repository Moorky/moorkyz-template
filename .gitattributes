# Store text as LF regardless of core.autocrlf; Windows batch files need CRLF.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Never convert or diff these as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff2 binary
*.pdf binary
*.zip binary

# GitHub ZIP downloads record their template commit here (read by Claim Template).
.template/claim-template/helpers/template-commit.txt export-subst
