    if (line.startsWith("```")) {
      flush();
      if (inCode) {
        content.push(`<pre><code>${escape(code.join("\n"))}</code></pre>`);
        code = [];
      }
      inCode = !inCode;
    } else if (inCode) code.push(line);
    else if (!line.trim()) flush();
