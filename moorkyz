  return '<!doctype html>\n<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>' + escape(title) + '</title><style>body{max-width:66rem;margin:3rem auto;padding:0 1.5rem;font:1rem/1.75 system-ui,sans-serif;color:#18251b;background:#fafbf7}a{color:#245d35}h1,h2,h3{line-height:1.25}pre,code{background:#eef1e8}pre{padding:1rem;overflow:auto}img{max-width:100%}a:focus-visible{outline:2px solid #245d35;outline-offset:4px}</style></head><body><nav><a href="README.md">Markdown source</a></nav><main>\n'
