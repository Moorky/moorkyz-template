      const heading = /^(#{1,3}) (.+)$/.exec(line);
      if (heading) {
        flush();
        if (heading[1] === "#" && title === "README") title = heading[2].replaceAll("`", "");
        content.push(`<h${heading[1].length}>${inline(heading[2])}</h${heading[1].length}>`);
      } else paragraph.push(line);
    }
  }
