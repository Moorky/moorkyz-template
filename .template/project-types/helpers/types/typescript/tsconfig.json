{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": [
    "node_modules",
    ".template",
    ".moorkyz",
    ".logs",
    ".archive",
    "coverage",
    "dist",
    "build"
  ]
}
